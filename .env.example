# ========================================================
# yStore Environment Configuration
# ========================================================

# Base Site URL
APP_BASE_URL=http://localhost/toko-online/

# --------------------------------------------------------
# PILIHAN 1: KONEKSI DATABASE MYSQL / MARIADB (Default / XAMPP)
# --------------------------------------------------------
DB_DRIVER=mysqli
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=ystore

# --------------------------------------------------------
# PILIHAN 2: KONEKSI DATABASE SUPABASE (POSTGRESQL)
# Dapatkan di: Supabase Dashboard -> Project Settings -> Database -> Connection string
# --------------------------------------------------------
# Catatan: Gunakan Transaction Pooler (Port 6543) untuk serverless / cloud:
# DATABASE_URL=postgresql://postgres.zkhrqqsfvymevqlrrfyo:[YOUR-DB-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Atau format individual parameter:
# DB_DRIVER=postgre
# DB_HOST=db.zkhrqqsfvymevqlrrfyo.supabase.co
# DB_PORT=5432
# DB_USER=postgres
# DB_PASS=YOUR-DB-PASSWORD
# DB_NAME=postgres

# --------------------------------------------------------
# SUPABASE STORAGE CONFIGURATION (Untuk upload foto di Vercel)
# --------------------------------------------------------
SUPABASE_URL=https://zkhrqqsfvymevqlrrfyo.supabase.co
SUPABASE_KEY=sb_publishable_Fa002Kt7k0mZumoonA_7sw_9i3k2Aaa
SUPABASE_BUCKET=uploads
